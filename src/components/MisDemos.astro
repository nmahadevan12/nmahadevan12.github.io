---
---

<section class="mis-demos" aria-labelledby="mis-demos-title" data-mis-demos>
  <h2 id="mis-demos-title">Interactive DC reference</h2>
  <p class="lede">
    Five GPIO bits drive an R-2R ladder (0–3.3&nbsp;V). A non-inverting stage scales that to 0–10&nbsp;V,
    then a difference amp subtracts 5&nbsp;V for a bipolar −5…+5&nbsp;V output.
  </p>

  <div class="panel" data-dac-demo id="mis-dac">
    <div class="panel-head">
      <h3>R-2R → gain / offset</h3>
      <p>
        Click a bit on the ladder, scrub the code, or sweep all 32 levels. The ladder stays in the
        Pi’s 0–3.3&nbsp;V domain; the op-amps do the bipolar mapping.
      </p>
    </div>

    <div class="ladder-well" aria-hidden="true">
      <!--
        Classic R-2R: each bit → 2R into a node; R between nodes; terminating 2R to GND at LSB.
        b4 (MSB) … b0 (LSB) left → right. No overhang left of b4.
      -->
      <svg class="ladder" viewBox="0 0 640 176" role="presentation">
        <!-- bit stages: switch → 2R → node; R between nodes. Rail starts at b4 (no left stub). -->
        <g data-stage="0">
          <line x1="72" y1="88" x2="72" y2="48" stroke="#d4d4d8" stroke-width="2" data-leg></line>
          <text x="84" y="72" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
          <rect x="54" y="22" width="36" height="26" rx="6" fill="#f4f4f5" stroke="#d4d4d8" stroke-width="1.5" data-sw></rect>
          <text x="72" y="40" text-anchor="middle" fill="#71717a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-sw-label>0</text>
          <text x="72" y="14" text-anchor="middle" fill="#a1a1aa" font-size="10" font-weight="600" font-family="ui-monospace,monospace">b4</text>
          <line x1="72" y1="88" x2="136" y2="88" stroke="#d4d4d8" stroke-width="2" data-series></line>
          <text x="104" y="80" text-anchor="middle" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">R</text>
          <circle cx="72" cy="88" r="2.5" fill="#a1a1aa"></circle>
        </g>
        <g data-stage="1">
          <line x1="136" y1="88" x2="136" y2="48" stroke="#d4d4d8" stroke-width="2" data-leg></line>
          <text x="148" y="72" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
          <rect x="118" y="22" width="36" height="26" rx="6" fill="#f4f4f5" stroke="#d4d4d8" stroke-width="1.5" data-sw></rect>
          <text x="136" y="40" text-anchor="middle" fill="#71717a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-sw-label>0</text>
          <text x="136" y="14" text-anchor="middle" fill="#a1a1aa" font-size="10" font-weight="600" font-family="ui-monospace,monospace">b3</text>
          <line x1="136" y1="88" x2="200" y2="88" stroke="#d4d4d8" stroke-width="2" data-series></line>
          <text x="168" y="80" text-anchor="middle" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">R</text>
          <circle cx="136" cy="88" r="2.5" fill="#a1a1aa"></circle>
        </g>
        <g data-stage="2">
          <line x1="200" y1="88" x2="200" y2="48" stroke="#d4d4d8" stroke-width="2" data-leg></line>
          <text x="212" y="72" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
          <rect x="182" y="22" width="36" height="26" rx="6" fill="#f4f4f5" stroke="#d4d4d8" stroke-width="1.5" data-sw></rect>
          <text x="200" y="40" text-anchor="middle" fill="#71717a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-sw-label>0</text>
          <text x="200" y="14" text-anchor="middle" fill="#a1a1aa" font-size="10" font-weight="600" font-family="ui-monospace,monospace">b2</text>
          <line x1="200" y1="88" x2="264" y2="88" stroke="#d4d4d8" stroke-width="2" data-series></line>
          <text x="232" y="80" text-anchor="middle" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">R</text>
          <circle cx="200" cy="88" r="2.5" fill="#a1a1aa"></circle>
        </g>
        <g data-stage="3">
          <line x1="264" y1="88" x2="264" y2="48" stroke="#d4d4d8" stroke-width="2" data-leg></line>
          <text x="276" y="72" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
          <rect x="246" y="22" width="36" height="26" rx="6" fill="#f4f4f5" stroke="#d4d4d8" stroke-width="1.5" data-sw></rect>
          <text x="264" y="40" text-anchor="middle" fill="#71717a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-sw-label>0</text>
          <text x="264" y="14" text-anchor="middle" fill="#a1a1aa" font-size="10" font-weight="600" font-family="ui-monospace,monospace">b1</text>
          <line x1="264" y1="88" x2="328" y2="88" stroke="#d4d4d8" stroke-width="2" data-series></line>
          <text x="296" y="80" text-anchor="middle" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">R</text>
          <circle cx="264" cy="88" r="2.5" fill="#a1a1aa"></circle>
        </g>
        <g data-stage="4">
          <line x1="328" y1="88" x2="328" y2="48" stroke="#d4d4d8" stroke-width="2" data-leg></line>
          <text x="340" y="72" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
          <rect x="310" y="22" width="36" height="26" rx="6" fill="#f4f4f5" stroke="#d4d4d8" stroke-width="1.5" data-sw></rect>
          <text x="328" y="40" text-anchor="middle" fill="#71717a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-sw-label>0</text>
          <text x="328" y="14" text-anchor="middle" fill="#a1a1aa" font-size="10" font-weight="600" font-family="ui-monospace,monospace">b0</text>
          <circle cx="328" cy="88" r="2.5" fill="#a1a1aa"></circle>
        </g>

        <!-- terminating 2R to ground at LSB node -->
        <line x1="328" y1="88" x2="328" y2="128" stroke="#d4d4d8" stroke-width="2"></line>
        <text x="340" y="116" fill="#a1a1aa" font-size="10" font-family="ui-monospace,monospace">2R</text>
        <line x1="318" y1="128" x2="338" y2="128" stroke="#a1a1aa" stroke-width="1.6"></line>
        <line x1="321" y1="132" x2="335" y2="132" stroke="#a1a1aa" stroke-width="1.4"></line>
        <line x1="324" y1="136" x2="332" y2="136" stroke="#a1a1aa" stroke-width="1.2"></line>

        <!-- ladder tap from LSB node -->
        <line x1="328" y1="88" x2="382" y2="88" stroke="#1b7db3" stroke-width="2"></line>
        <circle cx="360" cy="88" r="4" fill="#1b7db3"></circle>
        <text x="360" y="158" text-anchor="middle" fill="#0f5f8a" font-size="11" font-weight="650" font-family="ui-monospace,monospace" data-ladder-v>— V</text>
        <text x="360" y="170" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="ui-monospace,monospace">V_R2R · 0–3.3 V</text>

        <!-- amp block -->
        <rect x="390" y="58" width="118" height="60" rx="8" fill="#fafafa" stroke="#d4d4d8" stroke-width="1.5"></rect>
        <text x="449" y="82" text-anchor="middle" fill="#52525b" font-size="11" font-weight="650" font-family="system-ui,sans-serif">op-amps</text>
        <text x="449" y="98" text-anchor="middle" fill="#71717a" font-size="10" font-family="ui-monospace,monospace">×3.03 · −5 V</text>
        <text x="449" y="112" text-anchor="middle" fill="#a1a1aa" font-size="9" font-family="ui-monospace,monospace">0–10 V → ±5 V</text>

        <line x1="508" y1="88" x2="536" y2="88" stroke="#1b7db3" stroke-width="2"></line>
        <circle cx="540" cy="88" r="4" fill="#1b7db3"></circle>
        <text x="548" y="84" fill="#0f5f8a" font-size="12" font-weight="700" font-family="ui-monospace,monospace" data-final-v>— V</text>
        <text x="548" y="102" fill="#a1a1aa" font-size="9" font-family="ui-monospace,monospace">Vout</text>
      </svg>
    </div>

    <div class="sliders">
      <label>
        <span class="lbl">Code <strong data-code-val>—</strong></span>
        <input type="range" data-code-range min="0" max="31" step="1" value="2" aria-label="DAC code" />
      </label>
    </div>

    <div class="ohm-controls">
      <button type="button" class="btn-play" data-sweep>Sweep 0→31</button>
      <button type="button" class="btn-soft" data-reset>Reset</button>
    </div>

    <dl class="readouts">
      <div>
        <dt>Code</dt>
        <dd data-r-code>—</dd>
      </div>
      <div>
        <dt>Binary</dt>
        <dd data-r-bin>—</dd>
      </div>
      <div>
        <dt>V_R2R</dt>
        <dd data-r-ladder>—</dd>
      </div>
      <div>
        <dt>Vout</dt>
        <dd data-r-vout>—</dd>
      </div>
    </dl>

    <div class="bars">
      <div class="volt-bar">
        <div class="bar-label">Ladder · 0 – 3.3 V</div>
        <div class="volt-track">
          <span class="tick" style="left: 0%">0</span>
          <span class="tick" style="left: 50%">1.65</span>
          <span class="tick" style="left: 100%">3.3</span>
          <div class="volt-fill ladder" data-ladder-fill></div>
          <div class="volt-needle" data-ladder-needle></div>
        </div>
      </div>
      <div class="volt-bar">
        <div class="bar-label">Output · −5 – +5 V</div>
        <div class="volt-track">
          <span class="tick" style="left: 0%">−5</span>
          <span class="tick" style="left: 50%">0</span>
          <span class="tick" style="left: 100%">+5</span>
          <div class="volt-fill" data-volt-fill></div>
          <div class="volt-needle" data-volt-needle></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountMisDemos } from '../scripts/mis-demos';

  const root = document.querySelector<HTMLElement>('[data-mis-demos]');
  if (root) mountMisDemos(root);
</script>

<style>
  .mis-demos {
    display: grid;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .lede {
    max-width: 44rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .panel-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .panel-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .ladder-well {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) - 2px);
    background: #fff;
  }

  .ladder {
    display: block;
    width: 100%;
    height: auto;
  }

  .readouts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
  }

  .readouts > div {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    background: var(--well);
  }

  .readouts dt {
    color: var(--text-faint);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .readouts dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sliders {
    display: grid;
    gap: 0.85rem;
  }

  .sliders label {
    display: grid;
    gap: 0.35rem;
  }

  .sliders .lbl {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .sliders .lbl strong {
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 650;
  }

  .sliders input[type='range'] {
    width: 100%;
    height: 1.25rem;
    accent-color: #141415;
  }

  .sliders input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 999px;
    background: #d4d4d8;
  }

  .sliders input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    margin-top: -5px;
    border: 2px solid #141415;
    border-radius: 50%;
    background: #fff;
  }

  .sliders input[type='range']::-moz-range-track {
    height: 4px;
    border-radius: 999px;
    background: #d4d4d8;
  }

  .sliders input[type='range']::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 2px solid #141415;
    border-radius: 50%;
    background: #fff;
  }

  .ohm-controls {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.75rem;
    align-items: center;
    justify-content: start;
  }

  .btn-play,
  .btn-soft {
    min-width: 4.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-play:hover,
  .btn-soft:hover {
    border-color: var(--text-muted);
  }

  .btn-play:disabled,
  .btn-soft:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .bars {
    display: grid;
    gap: 0.75rem;
  }

  .bar-label {
    margin-bottom: 0.35rem;
    color: var(--text-faint);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .volt-track {
    position: relative;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
    overflow: hidden;
  }

  .volt-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 0;
    background: #dbeafe;
    transition:
      left 0.12s ease,
      width 0.12s ease;
  }

  .volt-fill.ladder {
    left: 0;
    background: #e0f2fe;
  }

  .volt-needle {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: #1b7db3;
    left: 0;
    transition: left 0.12s ease;
  }

  .volt-track .tick {
    position: absolute;
    bottom: 0.25rem;
    transform: translateX(-50%);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
