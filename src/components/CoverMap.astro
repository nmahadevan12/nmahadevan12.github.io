---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Hotspot {
  id: string;
  label: string;
  detail: string;
  x: number;
  y: number;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  hotspots: Hotspot[];
  width?: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  caption,
  hotspots,
  width = 1600,
  sizes = '(min-width: 1200px) 1120px, 100vw',
  loading = 'eager',
} = Astro.props;
---

<figure class="cover-map" data-cover-map>
  <div class="frame">
    <Image
      class="photo"
      src={src}
      alt={alt}
      width={width}
      widths={[Math.round(width / 2), width]}
      sizes={sizes}
      loading={loading}
    />
    <ul class="pins" role="list">
      {
        hotspots.map((spot) => (
          <li class="pin" style={`--x: ${spot.x}%; --y: ${spot.y}%;`}>
            <button
              class="dot"
              type="button"
              aria-describedby={`hotspot-${spot.id}`}
              data-hotspot
            >
              <span class="sr">{spot.label}</span>
            </button>
            <div class="tip" id={`hotspot-${spot.id}`} role="tooltip">
              <strong>{spot.label}</strong>
              <p>{spot.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  <p class="hint">Hover or tap a marker to explore the board.</p>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-cover-map]')) {
    if (root.dataset.bound) continue;
    root.dataset.bound = 'true';

    const pins = [...root.querySelectorAll<HTMLElement>('.pin')];
    const clear = () => {
      for (const pin of pins) pin.classList.remove('is-open');
    };

    for (const pin of pins) {
      const button = pin.querySelector<HTMLButtonElement>('[data-hotspot]');
      if (!button) continue;

      button.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = pin.classList.contains('is-open');
        clear();
        if (!open) pin.classList.add('is-open');
      });

      button.addEventListener('focus', () => {
        clear();
        pin.classList.add('is-open');
      });
    }

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) clear();
    });
  }
</script>

<style>
  .cover-map {
    display: grid;
    gap: 0.65rem;
    justify-items: center;
  }

  .frame {
    position: relative;
    display: inline-block;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--well);
    overflow: hidden;
  }

  .photo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(620px, 75vh);
  }

  .pins {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    pointer-events: auto;
    z-index: 1;
  }

  .dot {
    position: relative;
    width: 1.05rem;
    height: 1.05rem;
    border: 2px solid #fff;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 1px rgb(20 20 21 / 0.2), 0 4px 14px rgb(20 20 21 / 0.18);
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -0.55rem;
    border-radius: 999px;
    border: 1px solid rgb(38 163 217 / 0.55);
    animation: pulse 2.2s ease-out infinite;
  }

  .dot:hover,
  .pin.is-open .dot,
  .dot:focus-visible {
    transform: scale(1.15);
    box-shadow: 0 0 0 2px rgb(38 163 217 / 0.45), 0 6px 18px rgb(20 20 21 / 0.22);
  }

  .dot:focus-visible {
    outline: none;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.7rem);
    z-index: 2;
    width: max(12rem, min(18rem, 70vw));
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    box-shadow: var(--shadow-window, 0 12px 40px rgb(20 20 21 / 0.12));
    color: var(--text);
    text-align: left;
    opacity: 0;
    transform: translate(-50%, 0.35rem);
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .tip strong {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .tip p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .pin:hover .tip,
  .pin.is-open .tip,
  .pin:focus-within .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Flip tip below the marker when near the top of the frame. */
  .pin:nth-child(-n + 4) .tip {
    bottom: auto;
    top: calc(100% + 0.7rem);
  }

  figcaption {
    color: var(--text-faint);
    font-size: 14px;
    text-align: center;
  }

  .hint {
    margin: 0;
    color: var(--text-faint);
    font-size: 13px;
    text-align: center;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.7);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  @media (hover: none) {
    .dot::after {
      animation: none;
    }
  }
</style>
