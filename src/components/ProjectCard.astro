---
import ProjectCover from './ProjectCover.astro';
import { formatDateRange, type Project } from '../lib/projects';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { project, headingLevel = 'h3', eager = false } = Astro.props;
const { data } = project;
const Heading = headingLevel;
---

<a class="card" href={`/projects/${project.id}/`} data-status={data.status} data-areas={data.areas.join(' ')}>
  <div class:list={['well', data.cover ? data.coverFit : 'art']}>
    <ProjectCover
      project={project}
      width={760}
      height={543}
      sizes="(min-width: 1200px) 544px, (min-width: 760px) 46vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      decorative
    />
  </div>
  <div class="body">
    <div class="row">
      <Heading class="title">{data.title}</Heading>
      <span class="btn btn-primary btn-sm">View</span>
    </div>
    <div class="badges">
      {
        data.statusLabel ? (
          <span class="badge badge-status">{data.statusLabel}</span>
        ) : (
          data.status === 'in-progress' && <span class="badge badge-live">In progress</span>
        )
      }
      {data.course && <span class="badge">{data.course}</span>}
      <span class="badge">{formatDateRange(data)}</span>
      {data.draft && <span class="badge badge-draft">Draft</span>}
    </div>
    {data.metric && <p class="metric">{data.metric}</p>}
    <p class="summary">{data.summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 18px 40px -24px rgb(16 24 40 / 0.4);
    transform: translateY(-2px);
  }

  .well {
    aspect-ratio: 7 / 5;
    overflow: hidden;
    background: var(--well);
  }

  .well :global(img),
  .well :global(canvas),
  .well :global(svg) {
    width: 100%;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card:hover .well :global(img),
  .card:hover .well :global(canvas),
  .card:hover .well :global(svg) {
    transform: scale(1.035);
  }

  .well.contain {
    padding: 7% 6%;
  }

  .well.art {
    background: #fff;
  }

  .body {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 0.65rem;
    padding: 1.05rem 1.2rem 1.25rem;
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .title {
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .row .btn {
    flex: none;
  }

  .card:hover .btn-primary {
    background: var(--btn-hover);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .badge-draft {
    border-style: dashed;
  }

  .badge-status {
    border-color: rgb(38 163 217 / 0.45);
    color: var(--btn);
  }

  .metric {
    color: var(--text);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .well :global(img),
    .well :global(canvas),
    .well :global(svg) {
      transition: none;
    }

    .card:hover {
      transform: none;
    }

    .card:hover .well :global(img),
    .card:hover .well :global(canvas),
    .card:hover .well :global(svg) {
      transform: none;
    }
  }
</style>
