---
import ProjectCover from './ProjectCover.astro';
import { formatDateRange, type Project } from '../lib/projects';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { project, headingLevel = 'h3', eager = false } = Astro.props;
const { data } = project;
const Heading = headingLevel;
---

<a class="card" href={`/projects/${project.id}/`} data-status={data.status} data-areas={data.areas.join(' ')}>
  <div class:list={['well', data.cover ? data.coverFit : 'art']}>
    <ProjectCover
      project={project}
      width={760}
      height={543}
      sizes="(min-width: 1200px) 544px, (min-width: 760px) 46vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      decorative
    />
  </div>
  <div class="body">
    <div class="row">
      <Heading class="title">{data.title}</Heading>
      <span class="btn btn-primary btn-sm">View</span>
    </div>
    <div class="badges">
      {data.status === 'in-progress' && <span class="badge badge-live">In progress</span>}
      {data.course && <span class="badge">{data.course}</span>}
      <span class="badge">{formatDateRange(data)}</span>
      {data.draft && <span class="badge badge-draft">Draft</span>}
    </div>
    <p class="summary">{data.summary}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    box-shadow: 0 14px 32px -20px rgb(16 24 40 / 0.35);
  }

  .well {
    aspect-ratio: 7 / 5;
    overflow: hidden;
    background: var(--well);
  }

  .well.contain {
    padding: 7% 6%;
  }

  .well.art {
    background: #fff;
  }

  .body {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 0.7rem;
    padding: 1rem 1.25rem 1.3rem;
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .row .btn {
    flex: none;
  }

  .card:hover .btn-primary {
    background: var(--btn-hover);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge-draft {
    border-style: dashed;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
