---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && href.endsWith('/') && path.startsWith(href);
---

<header class="site-header">
  <div class="container-wide bar">
    <a class="brand" href="/">{site.name}</a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list" id="nav-list" role="list" data-nav>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href={site.github} target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github" />
      </a>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-list"
        data-menu-button
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const navList = document.querySelector<HTMLElement>('[data-nav]');

  const setMenu = (open: boolean) => {
    if (!menuButton || !navList) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    navList.dataset.open = String(open);
  };

  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  navList?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }

  .brand {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav {
    margin-right: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .nav-list a {
    display: block;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--link);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-right: -8px;
  }

  .menu-btn :global(.icon-close) {
    display: none;
  }

  .menu-btn {
    display: none;
  }

  .menu-btn[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }

  .menu-btn[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 720px) {
    .menu-btn {
      display: inline-grid;
    }

    .bar {
      gap: 1rem;
    }

    .brand {
      margin-right: auto;
    }

    .nav {
      position: absolute;
      inset: var(--header-h) 0 auto;
      margin: 0;
    }

    .nav-list {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      box-shadow: 0 16px 24px -16px rgb(16 24 40 / 0.18);
    }

    .nav-list[data-open='true'] {
      display: flex;
    }

    .nav-list a {
      padding: 0.8rem 0;
      font-size: 16px;
    }

    .nav-list li + li {
      border-top: 1px solid var(--border);
    }
  }
</style>
