---
---

<section class="rv-demos" aria-labelledby="rv-demos-title" data-riscv-demos>
  <h2 id="rv-demos-title">Instruction bitfield inspector</h2>
  <p class="lede">
    Every RISC-V instruction is a 32-bit word. Click a bit or a field — or type your own word in the
    box — to see how the CPU splits it into opcode, registers, and immediates. The presets are real
    encodings from <code>tests.c</code>.
  </p>

  <div class="panel" data-bitfield id="bitfield-inspector">
    <div class="toolbar">
      <label class="hex-label">
        Word
        <input type="text" data-hex spellcheck="false" autocomplete="off" aria-label="Instruction hex" />
      </label>
      <span class="format" data-format>I-type</span>
      <code class="mnemonic" data-mnemonic>—</code>
    </div>

    <div class="presets" data-presets role="group" aria-label="Example instructions"></div>
    <div class="bits" data-bits role="group" aria-label="Thirty-two instruction bits"></div>
    <div class="fields" data-fields></div>
  </div>
</section>

<script>
  import { mountRiscVDemos } from '../scripts/riscv-demos';

  const root = document.querySelector<HTMLElement>('[data-riscv-demos]');
  if (root) mountRiscVDemos(root);
</script>

<style>
  .rv-demos {
    display: grid;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .lede {
    max-width: 44rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 18px 40px -28px rgb(16 24 40 / 0.35);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
  }

  .hex-label {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--text-faint);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hex-label input {
    width: 9.5rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
    color: var(--text);
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .format {
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .mnemonic {
    color: var(--text);
    font-size: 0.92rem;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .presets :global(.chip) {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .presets :global(.chip:hover) {
    border-color: var(--border-strong);
  }

  .presets :global(.chip.is-on) {
    border-color: #2563eb;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .bits {
    display: grid;
    grid-template-columns: repeat(32, minmax(0, 1fr));
    gap: 2px;
    overflow-x: auto;
  }

  .bits :global(.bit) {
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    min-width: 1.35rem;
    padding: 0.35rem 0 0.25rem;
    border: 1px solid color-mix(in srgb, var(--c) 35%, #e5e7eb);
    border-radius: 5px;
    background: color-mix(in srgb, var(--c) 10%, #fff);
    color: var(--c);
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .bits :global(.bit span) {
    color: var(--text-faint);
    font-size: 0.55rem;
    font-weight: 500;
  }

  .bits :global(.bit.is-on) {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 22%, #fff);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 40%, transparent);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.45rem;
  }

  .fields :global(.field) {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--c) 30%, #e5e7eb);
    border-left: 3px solid var(--c);
    border-radius: 8px;
    background: var(--well);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .fields :global(.field.is-on) {
    background: color-mix(in srgb, var(--c) 12%, #fff);
  }

  .fields :global(.fname) {
    color: var(--c);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .fields :global(.fbits) {
    color: var(--text-faint);
    font-size: 11px;
  }

  .fields :global(.fval) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .bits {
      grid-template-columns: repeat(16, minmax(0, 1fr));
    }
  }
</style>
