---
---

<section class="rv-demos" aria-labelledby="rv-demos-title" data-riscv-demos>
  <h2 id="rv-demos-title">Interactive ISA</h2>
  <p class="lede">
    Decode real encodings from the C harness, then step a short program the same way
    <code>step_cpu</code> walks fetch → decode → execute.
  </p>

  <div class="panel" data-bitfield id="bitfield-inspector">
    <div class="panel-head">
      <h3>Instruction bitfield inspector</h3>
      <p>
        Click a bit or a field. Encodings match <code>tests.c</code> —
        <code>0x01410093</code> is <code>ADDI x1, x2, 20</code>.
      </p>
    </div>

    <div class="toolbar">
      <label class="hex-label">
        Word
        <input type="text" data-hex spellcheck="false" autocomplete="off" aria-label="Instruction hex" />
      </label>
      <span class="format" data-format>I-type</span>
      <code class="mnemonic" data-mnemonic>—</code>
    </div>

    <div class="presets" data-presets role="group" aria-label="Example instructions"></div>
    <div class="bits" data-bits role="group" aria-label="Thirty-two instruction bits"></div>
    <div class="fields" data-fields></div>
  </div>

  <div class="panel" data-stepper id="step-debugger">
    <div class="panel-head">
      <h3>Step debugger</h3>
      <p>
        Programs use the same hand-assembled words as the harness. Step updates PC, the register
        file (x0 stays 0), and a window of the 4&nbsp;KB memory.
      </p>
    </div>

    <div class="presets" data-programs role="group" aria-label="Demo programs"></div>

    <div class="step-bar">
      <button type="button" class="btn" data-step>Step</button>
      <button type="button" class="btn ghost" data-reset>Reset</button>
      <span class="pc">PC <strong data-pc>0x00000000</strong></span>
    </div>
    <p class="status" data-status></p>

    <div class="step-grid">
      <div>
        <h4>Disassembly</h4>
        <div class="disasm" data-disasm></div>
      </div>
      <div>
        <h4>Registers</h4>
        <div class="regs" data-regs></div>
      </div>
      <div class="mem-col">
        <h4>Memory</h4>
        <div class="mem" data-mem></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountRiscVDemos } from '../scripts/riscv-demos';

  const root = document.querySelector<HTMLElement>('[data-riscv-demos]');
  if (root) mountRiscVDemos(root);
</script>

<style>
  .rv-demos {
    display: grid;
    gap: 1.75rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .lede {
    max-width: 42rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .panel-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .panel-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
  }

  .hex-label {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--text-faint);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hex-label input {
    width: 9.5rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
    color: var(--text);
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .format {
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .mnemonic {
    color: var(--text);
    font-size: 0.92rem;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .presets :global(.chip),
  .btn {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .presets :global(.chip:hover),
  .btn:hover {
    border-color: var(--border-strong);
  }

  .presets :global(.chip.is-on) {
    border-color: #2563eb;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .btn.ghost {
    background: #fff;
  }

  .bits {
    display: grid;
    grid-template-columns: repeat(32, minmax(0, 1fr));
    gap: 2px;
    overflow-x: auto;
  }

  .bits :global(.bit) {
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    min-width: 1.35rem;
    padding: 0.35rem 0 0.25rem;
    border: 1px solid color-mix(in srgb, var(--c) 35%, #e5e7eb);
    border-radius: 5px;
    background: color-mix(in srgb, var(--c) 10%, #fff);
    color: var(--c);
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }

  .bits :global(.bit span) {
    color: var(--text-faint);
    font-size: 0.55rem;
    font-weight: 500;
  }

  .bits :global(.bit.is-on) {
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 22%, #fff);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 40%, transparent);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.45rem;
  }

  .fields :global(.field) {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--c) 30%, #e5e7eb);
    border-left: 3px solid var(--c);
    border-radius: 8px;
    background: var(--well);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .fields :global(.field.is-on) {
    background: color-mix(in srgb, var(--c) 12%, #fff);
  }

  .fields :global(.fname) {
    color: var(--c);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .fields :global(.fbits) {
    color: var(--text-faint);
    font-size: 11px;
  }

  .fields :global(.fval) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .step-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .pc {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .pc strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--text);
  }

  .status {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .step-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(7rem, 0.7fr);
    gap: 0.85rem;
  }

  .step-grid h4 {
    margin: 0 0 0.45rem;
    color: var(--text-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .disasm,
  .regs,
  .mem {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--well);
  }

  .disasm :global(.line) {
    display: grid;
    grid-template-columns: 5.5rem 5.5rem minmax(0, 1fr);
    gap: 0.4rem;
    padding: 0.4rem 0.55rem;
    border-bottom: 1px solid var(--border);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
  }

  .disasm :global(.line:last-child) {
    border-bottom: 0;
  }

  .disasm :global(.line.is-pc) {
    background: #eff6ff;
    box-shadow: inset 3px 0 0 #2563eb;
  }

  .disasm :global(.addr),
  .disasm :global(.hex) {
    color: var(--text-faint);
  }

  .disasm :global(.asm) {
    font-weight: 600;
  }

  .regs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    overflow: hidden;
  }

  .regs :global(.reg) {
    display: grid;
    gap: 0.1rem;
    padding: 0.35rem 0.4rem;
    background: #fff;
  }

  .regs :global(.reg.is-hot) {
    background: #ecfdf5;
  }

  .regs :global(.reg.is-zero) {
    opacity: 0.72;
  }

  .regs :global(.rn) {
    color: var(--text-faint);
    font-size: 10px;
    font-weight: 650;
  }

  .regs :global(.rv) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .mem {
    display: grid;
    grid-template-columns: 1fr;
  }

  .mem :global(.byte) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.28rem 0.5rem;
    border-bottom: 1px solid var(--border);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
  }

  .mem :global(.byte:last-child) {
    border-bottom: 0;
  }

  .mem :global(.byte.is-hot) {
    background: #fff7ed;
  }

  .mem :global(.ma) {
    color: var(--text-faint);
  }

  .mem :global(.mv) {
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .step-grid {
      grid-template-columns: 1fr;
    }

    .bits {
      grid-template-columns: repeat(16, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .regs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .disasm :global(.line) {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
