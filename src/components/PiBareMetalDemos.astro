---
---

<section class="pi-demos" aria-labelledby="pi-demos-title" data-pi-demos>
  <h2 id="pi-demos-title">Interactive bring-up</h2>
  <p class="lede">
    Walk the AArch64 boot stub from <code>boot.S</code>, then step the same AUX mini UART bring-up
    <code>main.c</code> does — enable AUX, set baud, put GPIO 14 in Alt5, and transmit bytes.
  </p>

  <div class="panel" data-boot-demo id="boot-stub">
    <div class="panel-head">
      <h3>Boot stub</h3>
      <p>
        GPU firmware loads <code>kernel8.img</code> at <code>0x80000</code>. Core 0 parks the others,
        sets the stack, clears <code>.bss</code>, and calls <code>main</code>.
      </p>
    </div>

    <div class="cores" data-cores aria-label="Four Cortex-A53 cores"></div>

    <div class="boot-steps" data-boot-steps role="list" aria-label="Boot sequence steps"></div>

    <div class="boot-body">
      <p class="boot-detail" data-boot-detail></p>
      <pre class="boot-code" data-boot-code></pre>
    </div>

    <div class="boot-nav">
      <button type="button" class="btn-soft" data-boot-prev>Previous</button>
      <button type="button" class="btn-soft" data-boot-next>Next</button>
    </div>
  </div>

  <div class="panel" data-uart-demo id="mini-uart">
    <div class="panel-head">
      <h3>Mini UART TX</h3>
      <p>
        Same MMIO as the firmware: enable AUX, program baud for 115200 at 250&nbsp;MHz, set GPIO 14 to
        Alt5 (TXD1), then push bytes into <code>AUX_MU_IO</code> when the TX FIFO is empty.
      </p>
    </div>

    <div class="uart-stage">
      <div class="uart-terminal" aria-label="Serial output">
        <div class="uart-chrome">
          <span>115200 8N1 · GPIO 14 TX</span>
          <strong data-uart-status>idle</strong>
        </div>
        <pre class="uart-out" data-uart-out></pre>
      </div>

      <div class="reg-cards" aria-label="Memory-mapped registers">
        <div class="reg">
          <span class="addr">AUX_ENABLES · 0x3F215004</span>
          <code data-aux-en-hex>0x00000000</code>
        </div>
        <div class="reg">
          <span class="addr">AUX_MU_BAUD · 0x3F215068</span>
          <code data-baud-hex>0x00000000</code>
        </div>
        <div class="reg">
          <span class="addr">GPFSEL1 · 0x3F200004</span>
          <code data-gpfsel-hex>0x00000000</code>
        </div>
        <div class="reg">
          <span class="addr">AUX_MU_CNTL · 0x3F215060</span>
          <code data-cntl-hex>0x00000000</code>
        </div>
      </div>
    </div>

    <div class="uart-controls">
      <button type="button" class="btn-soft" data-uart-setup>Run miniUartSetup</button>
      <button type="button" class="btn-play" data-uart-play disabled>Transmit loop</button>
      <button type="button" class="btn-soft" data-uart-step disabled>Send next byte</button>
      <button type="button" class="btn-soft" data-uart-reset>Reset</button>
    </div>

    <div class="mmio-log" data-mmio-log aria-live="polite" aria-label="MMIO write log"></div>
  </div>
</section>

<script>
  import { mountPiBareMetalDemos } from '../scripts/pi-bare-metal-demos';

  const root = document.querySelector<HTMLElement>('[data-pi-demos]');
  if (root) mountPiBareMetalDemos(root);
</script>

<style>
  .pi-demos {
    display: grid;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .lede {
    max-width: 44rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 18px 40px -28px rgb(16 24 40 / 0.35);
  }

  .panel-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .panel-head p {
    margin: 0;
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cores {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .cores :global(.core) {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .cores :global(.core[data-state='run']) {
    border-color: #9fd0a8;
    background: #f3faf5;
  }

  .cores :global(.core[data-state='parked']) {
    border-color: var(--border);
    background: #f3f4f6;
    color: var(--text-faint);
  }

  .cores :global(.core strong) {
    font-size: 0.82rem;
    font-weight: 650;
  }

  .cores :global(.core span) {
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .boot-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .boot-steps :global(button) {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }

  .boot-steps :global(button[data-active='1']) {
    border-color: var(--btn);
    box-shadow: inset 0 0 0 1px var(--btn);
  }

  .boot-steps :global(button[data-done='1']) {
    background: var(--bg-subtle);
  }

  .boot-steps :global(.n) {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .boot-steps :global(.t) {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .boot-body {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0.85rem;
  }

  .boot-detail {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .boot-code {
    margin: 0;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius);
    background: #0f1720;
    color: #e8eef5;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.45;
    white-space: pre-wrap;
  }

  .boot-nav,
  .uart-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-soft,
  .btn-play {
    appearance: none;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }

  .btn-play {
    background: var(--btn);
    border-color: var(--btn);
    color: var(--btn-text);
  }

  .btn-play:hover:not(:disabled) {
    background: var(--btn-hover);
  }

  .btn-soft:hover:not(:disabled),
  .btn-play:hover:not(:disabled) {
    filter: brightness(0.98);
  }

  .btn-soft:disabled,
  .btn-play:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .uart-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  .uart-terminal {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 11rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0f1720;
  }

  .uart-chrome {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    color: #94a3b8;
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }

  .uart-chrome strong {
    color: #e2e8f0;
    font-weight: 650;
  }

  .uart-out {
    margin: 0;
    padding: 0.75rem 0.85rem;
    color: #86efac;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-all;
    min-height: 7.5rem;
  }

  .reg-cards {
    display: grid;
    gap: 0.45rem;
  }

  .reg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .reg .addr {
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  .reg code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .mmio-log {
    min-height: 5.5rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #0f1720;
    color: #c9d4e0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    overflow: hidden;
  }

  .mmio-log :global(div) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 900px) {
    .cores,
    .boot-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .boot-body,
    .uart-stage {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .boot-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
