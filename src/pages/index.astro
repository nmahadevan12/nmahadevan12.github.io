---
import Capture from '../components/Capture.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Resume from '../components/Resume.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCaptureChannels } from '../lib/capture-data';
import { featuredFirst, getProjects } from '../lib/projects';

const projects = await getProjects();
const channels = buildCaptureChannels(projects);
/** Strongest completed work only — no drafts / thin WIP on the homepage row. */
const shown = featuredFirst(projects).filter((p) => p.data.featured).slice(0, 4);
---

<BaseLayout>
  {
    /*
      Hero photos in public/hero/: 1-left.jpg, 1-right.jpg.
    */
  }
  <section class="stage stage-1" aria-labelledby="hero-title">
    <div class="stage-photos" aria-hidden="true">
      <img class="photo photo-left" src="/hero/1-left.jpg" alt="" width="822" height="864" decoding="async" />
      <img class="photo photo-right" src="/hero/1-right.jpg" alt="" width="1988" height="390" decoding="async" />
    </div>
    <div class="stage-copy">
      <h1 id="hero-title">{site.name}</h1>
      <p class="lede">
        {site.intro}
        <br />
        <span class="lede-meta">{site.introMeta}</span>
      </p>
      <p class="lede-detail">{site.introDetail}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/projects/">View projects</a>
        <a class="btn btn-secondary" href={site.resume} target="_blank" rel="noopener">Résumé</a>
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="section projects" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="projects-title">Projects</h2>
        <a class="btn btn-secondary" href="/projects/">See all projects</a>
      </div>
      <div class="cards">
        {shown.map((project, index) => <ProjectCard project={project} eager={index < 2} />)}
      </div>
    </div>
  </section>

  <Resume channels={channels} show="experience" />

  <Resume channels={channels} show="education" />

  <section class="section capture-section" id="capture" aria-labelledby="capture-title">
    <div class="capture-wrap">
      <div class="capture-head">
        <h2 class="section-title" id="capture-title">Timeline</h2>
        <p class="lede">
          Optional view of the same roles and projects as a logic-analyzer-style capture — click a channel for details.
          Prefer plain text? Jump to <a href="#experience">Experience</a> or
          <a href="#projects">Projects</a> above.
          <span class="hint">Pinch, scroll, or swipe to explore the UART decode.</span>
        </p>
      </div>
      <Capture channels={channels} />
    </div>
  </section>

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <h2 class="section-title" id="contact-title">Contact</h2>
      <p class="lede">{site.availability} Email is the quickest way to reach me.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <p class="email">{site.email}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    background: #fff;
    color: #141415;
    height: 400px;
  }

  .stage-1 {
    height: calc(100svh - var(--header-h));
    min-height: 400px;
  }

  .stage::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 10;
    height: 1px;
    background: #e5e7eb;
  }

  .stage-photos {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .photo {
    position: absolute;
    max-width: none;
    user-select: none;
  }

  /* Laptop + analyzer pair — slight left bias, modest gap between them. */
  .stage-1 .photo-left {
    left: 7%;
    bottom: 0;
    height: 50%;
    width: auto;
    max-width: 36%;
    object-fit: contain;
    object-position: right bottom;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 28%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 28%, #000 100%);
  }

  .stage-1 .photo-right {
    left: auto;
    right: 10%;
    bottom: 0;
    width: 56%;
    height: 28%;
    object-fit: cover;
    /* Anchor left so the Saleae side with the logo is never cropped. */
    object-position: left bottom;
    /* Fade top + only the far right edge of the probe. */
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0%, #000 35%, #000 100%),
      linear-gradient(to right, #000 88%, transparent 100%);
    -webkit-mask-composite: destination-in;
    mask-image:
      linear-gradient(to bottom, transparent 0%, #000 35%, #000 100%),
      linear-gradient(to right, #000 88%, transparent 100%);
    mask-composite: intersect;
  }

  .stage-copy {
    position: relative;
    z-index: 20;
    width: min(100% - 2 * var(--gutter), 90rem);
    margin-inline: auto;
    padding: 1.5rem var(--gutter) 0;
    text-align: center;
  }

  .stage h1 {
    font-size: clamp(1.85rem, 5.5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .stage .lede {
    max-width: 42rem;
    margin: 0.5rem auto 0;
    color: #475467;
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    line-height: 1.45;
  }

  .stage .lede-meta {
    white-space: nowrap;
  }

  .stage .lede-detail {
    max-width: 40rem;
    margin: 0.4rem auto 0;
    color: #667085;
    font-size: clamp(0.88rem, 1.6vw, 1.05rem);
    line-height: 1.45;
  }

  .stage .btn-row {
    margin-top: 1.25rem;
  }

  .stage .btn-secondary {
    border-color: #d1d5db;
    color: #141415;
    background: #fff;
  }

  .stage .btn-secondary:hover {
    background: #f9fafb;
    border-color: #98a2b3;
  }

  @media (max-width: 639px) {
    .stage-1 .photo-left {
      left: 4%;
      height: 46%;
      max-width: 44%;
    }

    .stage-1 .photo-right {
      right: 4%;
      width: 62%;
      height: 26%;
      bottom: 0;
      object-position: left bottom;
    }

    .stage .lede-meta {
      white-space: normal;
    }
  }

  @media (min-width: 640px) {
    .stage {
      height: 600px;
    }

    .stage-1 {
      height: calc(100svh - var(--header-h));
    }

    .stage-copy {
      padding-top: 4rem;
    }

    .stage .btn-row {
      margin-top: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .stage {
      height: 900px;
    }

    .stage-1 {
      height: calc(100svh - var(--header-h));
      min-height: 640px;
    }

    .stage-copy {
      padding-top: 6.5rem;
    }

    .stage h1 {
      line-height: 90px;
    }

    .stage .lede {
      margin-top: 0.5rem;
    }

    .stage .btn-row {
      margin-top: 1.5rem;
    }
  }

  .capture-section {
    padding-top: clamp(2.75rem, 5vw, 4.25rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .capture-wrap {
    width: min(100% - 2 * var(--gutter), var(--wide-w));
    margin-inline: auto;
  }

  .capture-head {
    max-width: 42rem;
    margin-bottom: 1.15rem;
  }

  .capture-head .lede {
    margin-top: 0.45rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
  }

  .capture-head .lede a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .capture-head .lede a:hover {
    color: var(--text);
  }

  .capture-head .hint {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.95em;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .contact {
    border-top: 1px solid var(--border);
  }

  .contact-inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .contact .lede {
    max-width: 36rem;
  }

  .contact .btn-row {
    margin-top: 0.75rem;
  }

  .email {
    color: var(--text-faint);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
