---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import CoverMap from '../../components/CoverMap.astro';
import Icon from '../../components/Icon.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import PcbViewer from '../../components/PcbViewer.astro';
import PiBareMetalDemos from '../../components/PiBareMetalDemos.astro';
import RiscVDemos from '../../components/RiscVDemos.astro';
import WakeWordDemos from '../../components/WakeWordDemos.astro';
import MisDemos from '../../components/MisDemos.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { IconName } from '../../lib/icons';
import {
  formatDateRange,
  getAllProjectsIncludingDrafts,
  getProjects,
  type Project,
} from '../../lib/projects';
import { AREA_LABELS, STATUS_LABELS } from '../../lib/taxonomy';

export async function getStaticPaths() {
  // Listings never show drafts; in DEV, draft URLs still build so you can preview them.
  const projects = import.meta.env.DEV
    ? await getAllProjectsIncludingDrafts()
    : await getProjects();
  const nav = await getProjects();
  return projects.map((project) => {
    const i = nav.findIndex((p) => p.id === project.id);
    return {
      params: { id: project.id },
      props: {
        project,
        previous: i > 0 ? nav[i - 1] : undefined,
        next: i >= 0 ? nav[i + 1] : undefined,
      },
    };
  });
}

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const links: { href: string; label: string; icon: IconName }[] = [];
if (data.repo) links.push({ href: data.repo, label: 'Source code', icon: 'github' });
if (data.video) links.push({ href: data.video, label: 'Watch demo', icon: 'play' });
if (data.demo) links.push({ href: data.demo, label: 'Live demo', icon: 'globe' });
if (data.docs) links.push({ href: data.docs, label: 'Documentation', icon: 'book' });

const statusDisplay = data.statusLabel ?? STATUS_LABELS[data.status];

const specs: { label: string; value?: string | string[] }[] = [
  { label: 'Timeline', value: formatDateRange(data) },
  { label: 'Status', value: statusDisplay },
  { label: 'Area', value: data.areas.map((area) => AREA_LABELS[area]).join(', ') },
  { label: 'Platform', value: data.platform },
  { label: 'Course', value: data.course },
  { label: 'Role', value: data.role },
  { label: 'Stack', value: data.tags },
].filter((spec) => spec.value?.length);

const gallery = await Promise.all(
  data.gallery.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.src, width: Math.min(item.src.width, 2000) }),
  })),
);

const ogCover = data.cover
  ? (await getImage({ src: data.cover, width: 1200 })).src
  : undefined;

/** Specs stops with the writeup; interactives (+ gallery) go full-width below. */
const wideExtras =
  project.id === 'edge-ai-wake-word' ||
  project.id === 'risc-v-emulator' ||
  project.id === 'raspberry-pi-bare-metal' ||
  project.id === 'multifunction-instrumentation-system';
const showWakeDemos = project.id === 'edge-ai-wake-word';
const showRiscDemos = project.id === 'risc-v-emulator';
const showPiDemos = project.id === 'raspberry-pi-bare-metal';
const showMisDemos = project.id === 'multifunction-instrumentation-system';
---

<BaseLayout title={data.title} description={data.summary} image={ogCover}>
  <article>
    <header class="head">
      <div class="container head-inner" data-reveal data-parallax="0.18">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/projects/">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{data.title}</span>
        </nav>

        <h1>{data.title}</h1>
        <p class="section-lede">{data.summary}</p>

        <div class="badges">
          {
            data.statusLabel ? (
              <span class="badge badge-status">{data.statusLabel}</span>
            ) : (
              data.status === 'in-progress' && <span class="badge badge-live">In progress</span>
            )
          }
          {data.course && <span class="badge">{data.course}</span>}
          <span class="badge">{formatDateRange(data)}</span>
          {data.draft && <span class="badge badge-draft">Draft, hidden when published</span>}
        </div>

        {
          links.length > 0 && (
            <div class="btn-row links">
              {links.map((link, index) => (
                <a
                  class:list={['btn', index === 0 ? 'btn-primary' : 'btn-secondary']}
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name={link.icon} size={17} />
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="cover-band page-band">
      {
        data.model3d ? (
          <div class="container cover" data-reveal data-parallax="0.26">
            <PcbViewer
              src={data.model3d}
              alt={data.model3dAlt ?? data.coverAlt ?? data.title}
              caption={data.model3dCaption ?? data.coverCaption}
              parts={data.model3dParts}
              nets={data.model3dNets}
            />
          </div>
        ) : data.cover && data.coverHotspots.length > 0 ? (
          <div class="container cover" data-reveal>
            <div class="parallax-media" data-parallax="0.34">
              <CoverMap
                src={data.cover}
                alt={data.coverAlt ?? data.title}
                caption={data.coverCaption}
                hotspots={data.coverHotspots}
                width={1600}
                sizes="(min-width: 1200px) 1120px, 100vw"
                loading="eager"
              />
            </div>
          </div>
        ) : (
          <figure
            class:list={[
              'container',
              'cover',
              { contain: data.coverFit === 'contain', photo: !!data.cover },
            ]}
            data-reveal
          >
            <div
              class:list={[
                'cover-well',
                { art: !data.cover, contain: data.coverFit === 'contain', photo: !!data.cover },
              ]}
            >
              <div class="parallax-media" data-parallax="0.34">
                <ProjectCover
                  project={project}
                  width={1600}
                  sizes="(min-width: 1200px) 1120px, 100vw"
                  loading="eager"
                  art={{ width: 1120, height: 460 }}
                />
              </div>
            </div>
            {data.coverCaption && <figcaption>{data.coverCaption}</figcaption>}
          </figure>
        )
      }
    </div>

    <div class:list={['container body', { 'has-extras': wideExtras }]}>
      <aside class="aside" aria-labelledby="specs-title" data-reveal>
        <h2 id="specs-title">Specs</h2>
        <dl class="specs surface surface-pad">
          {
            specs.map((spec) => (
              <div>
                <dt>{spec.label}</dt>
                <dd>
                  {Array.isArray(spec.value)
                    ? spec.value.map((item, i) => (
                        <>
                          {i > 0 && ' · '}
                          <span class="item">{item}</span>
                        </>
                      ))
                    : spec.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>

      <div class="main" data-reveal style="--reveal-delay: 80ms">
        {
          data.highlights.length > 0 && (
            <section class="highlights" aria-labelledby="highlights-title">
              <h2 id="highlights-title">Highlights</h2>
              <ul>
                {data.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {!wideExtras && showWakeDemos && <WakeWordDemos />}
        {!wideExtras && showRiscDemos && <RiscVDemos />}
        {!wideExtras && showPiDemos && <PiBareMetalDemos />}
        {!wideExtras && showMisDemos && <MisDemos />}

        {
          !wideExtras && gallery.length > 0 && (
            <section class="gallery" aria-labelledby="gallery-title">
              <h2 id="gallery-title">Gallery</h2>
              <div class="gallery-grid">
                {gallery.map((item, i) => (
                  <figure data-parallax={i % 2 === 0 ? '0.22' : '0.34'}>
                    <button
                      class="shot"
                      type="button"
                      aria-label={`Enlarge image: ${item.caption}`}
                      data-full={item.full.src}
                      data-caption={item.caption}
                    >
                      <Image src={item.src} alt={item.caption} width={720} />
                      <span class="zoom" aria-hidden="true">
                        <Icon name="expand" size={15} />
                      </span>
                    </button>
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>

    {
      wideExtras && (
        <div class="extras-band page-band">
          <div class="container extras" data-reveal data-parallax="0.18">
            {showWakeDemos && <WakeWordDemos />}
            {showRiscDemos && <RiscVDemos />}
            {showPiDemos && <PiBareMetalDemos />}
            {showMisDemos && <MisDemos />}
            {gallery.length > 0 && (
              <section class="gallery" aria-labelledby="gallery-title">
                <h2 id="gallery-title">Gallery</h2>
                <div class="gallery-grid">
                  {gallery.map((item, i) => (
                    <figure data-parallax={i % 2 === 0 ? '0.22' : '0.34'}>
                      <button
                        class="shot"
                        type="button"
                        aria-label={`Enlarge image: ${item.caption}`}
                        data-full={item.full.src}
                        data-caption={item.caption}
                      >
                        <Image src={item.src} alt={item.caption} width={720} />
                        <span class="zoom" aria-hidden="true">
                          <Icon name="expand" size={15} />
                        </span>
                      </button>
                      <figcaption>{item.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>
      )
    }

    <nav class="pager-band" aria-label="More projects">
      <div class="container pager" data-reveal>
        {
          previous ? (
            <a class="pager-link" href={`/projects/${previous.id}/`}>
              <span class="dir">
                <Icon name="arrow-left" size={14} />
                Previous
              </span>
              <span class="name">{previous.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="pager-link to-next" href={`/projects/${next.id}/`}>
              <span class="dir">
                Next
                <Icon name="arrow-right" size={14} />
              </span>
              <span class="name">{next.data.title}</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>

  <dialog class="lightbox" aria-label="Image viewer" data-lightbox>
    <form method="dialog">
      <button class="icon-btn close" aria-label="Close image viewer">
        <Icon name="close" />
      </button>
    </form>
    <img alt="" data-lightbox-image />
    <p class="lightbox-caption" data-lightbox-caption></p>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');

  for (const shot of document.querySelectorAll<HTMLButtonElement>('[data-full]')) {
    shot.addEventListener('click', () => {
      if (!dialog || !image || !caption || !shot.dataset.full) return;
      image.src = shot.dataset.full;
      image.alt = shot.dataset.caption ?? '';
      caption.textContent = shot.dataset.caption ?? '';
      dialog.showModal();
    });
  }

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .head {
    padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(ellipse 70% 80% at 50% -20%, rgb(38 163 217 / 0.08), transparent 55%),
      #fff;
  }

  .head-inner {
    max-width: 46rem;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.15rem;
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
  }

  .crumbs a {
    color: var(--link);
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current] {
    color: var(--text-muted);
  }

  h1 {
    max-width: 22ch;
    margin-top: 0.35rem;
    font-size: clamp(2.1rem, 4.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .section-lede {
    max-width: 40rem;
    margin-top: 0.75rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .badge-draft {
    border-style: dashed;
  }

  .badge-status {
    border-color: rgb(38 163 217 / 0.45);
    color: var(--btn);
  }

  .links {
    justify-content: flex-start;
    margin-top: 1.5rem;
  }

  .cover-band {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--border);
    overflow: clip;
  }

  .cover {
    display: grid;
    gap: 0.75rem;
  }

  .cover .parallax-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .cover.contain,
  .cover.photo {
    gap: 0.4rem;
  }

  .cover-well {
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--well);
    box-shadow: 0 18px 40px -28px rgb(16 24 40 / 0.35);
  }

  /* Shrink-wrap to the photo — no outer card around the image. */
  .cover-well.photo,
  .cover-well.contain {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    border: none;
    border-radius: var(--radius-lg);
    background: transparent;
    box-shadow: none;
  }

  .cover-well :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(620px, 75vh);
  }

  .cover-well.photo :global(img),
  .cover-well.contain :global(img) {
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -28px rgb(16 24 40 / 0.35);
  }

  .cover-well.contain :global(img) {
    max-height: min(400px, 50vh);
  }

  .cover-well.art {
    aspect-ratio: 1120 / 460;
    width: 100%;
    max-height: min(460px, 55vh);
    border-color: var(--border);
    background: #fff;
  }

  .cover-well.art .parallax-media,
  .cover-well.art :global(.cover-art) {
    height: 100%;
  }

  .cover figcaption {
    color: var(--text-faint);
    font-size: 14px;
    text-align: center;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(2.75rem, 5.5vw, 4.25rem);
  }

  .body.has-extras {
    /* Sticky Specs lives only in this block — once you scroll into .extras, it leaves. */
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .extras-band {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .extras {
    display: grid;
    gap: 0;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }

  .extras :global(.ww-demos),
  .extras :global(.rv-demos),
  .extras :global(.pi-demos),
  .extras :global(.mis-demos) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .extras .gallery {
    margin-top: 3rem;
  }

  .aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    grid-column: 2;
    grid-row: 1;
  }

  .aside h2,
  .highlights h2,
  .gallery h2 {
    margin-bottom: 0.9rem;
    font-size: clamp(1.35rem, 2.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .aside .specs {
    border-top: 0;
  }

  .aside .specs > div {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    padding-block: 0.75rem;
  }

  .aside .specs > div:last-child {
    border-bottom: 0;
  }

  .aside .specs dd {
    font-size: 14px;
  }

  .item {
    white-space: nowrap;
  }

  .main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    max-width: 46rem;
  }

  .highlights {
    margin-bottom: 2.75rem;
    padding: 1.15rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, #f8fafc 0%, #fff 100%);
  }

  .highlights ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .gallery {
    margin-top: 3.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gallery-grid figure {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .shot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    width: 100%;
    padding: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 14px 32px -24px rgb(16 24 40 / 0.3);
    cursor: zoom-in;
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .shot:hover {
    border-color: var(--border-strong);
    box-shadow: 0 18px 40px -24px rgb(16 24 40 / 0.4);
    transform: translateY(-2px);
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shot:hover :global(img) {
    transform: scale(1.03);
  }

  .zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: rgb(20 20 21 / 0.75);
    color: #f4f4f5;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .shot:hover .zoom,
  .shot:focus-visible .zoom {
    opacity: 1;
  }

  .gallery-grid figcaption {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .pager-band {
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, #fafbfc 0%, #fff 70%);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 2.25rem clamp(3.5rem, 7vw, 5.25rem);
  }

  .pager-link {
    display: grid;
    gap: 0.3rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 14px 32px -24px rgb(16 24 40 / 0.28);
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .pager-link:hover {
    border-color: var(--border-strong);
    box-shadow: 0 18px 40px -24px rgb(16 24 40 / 0.4);
    transform: translateY(-2px);
  }

  .pager-link:hover .name {
    color: var(--link);
  }

  .to-next {
    grid-column: 2;
    text-align: right;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-faint);
    font-size: 13px;
    font-weight: 500;
  }

  .to-next .dir {
    justify-content: flex-end;
  }

  .name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .lightbox {
    min-width: min(30rem, 94vw);
    max-width: 94vw;
    max-height: 94vh;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
  }

  .lightbox::backdrop {
    background: rgb(10 10 11 / 0.82);
    backdrop-filter: blur(4px);
  }

  .lightbox img {
    max-height: calc(94vh - 4.5rem);
    margin-inline: auto;
    background: var(--well);
  }

  /* Zero intrinsic width so long captions wrap instead of widening the dialog past the image. */
  .lightbox-caption {
    width: 0;
    min-width: 100%;
    padding: 0.9rem 1.2rem;
    color: var(--text-muted);
    font-size: 14px;
  }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    background: rgb(20 20 21 / 0.75);
    color: #f4f4f5;
  }

  .close:hover {
    background: rgb(20 20 21 / 0.9);
  }

  @media (max-width: 960px) {
    .body {
      grid-template-columns: 1fr;
    }

    .aside,
    .main {
      position: static;
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid,
    .pager {
      grid-template-columns: 1fr;
    }

    .to-next {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot,
    .shot :global(img),
    .pager-link {
      transition: none;
    }

    .shot:hover,
    .pager-link:hover {
      transform: none;
    }

    .shot:hover :global(img) {
      transform: none;
    }
  }
</style>
